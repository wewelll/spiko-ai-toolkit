# Optional endpoint overrides.
SPIKO_PUBLIC_API_BASE_URL=https://public-api.spiko.io/v0
SPIKO_INVESTOR_API_BASE_URL=https://investor-api.spiko.io/v1
SPIKO_DISTRIBUTOR_API_BASE_URL=https://distributor-api.spiko.io/v0

# Investor API: use an API key (preferred), bearer token, or Basic Auth credentials.
# SPIKO_INVESTOR_API_KEY=
# SPIKO_INVESTOR_ACCESS_TOKEN=
# SPIKO_INVESTOR_CLIENT_ID=
# SPIKO_INVESTOR_CLIENT_SECRET=

# Distributor API: Basic Auth credentials.
# SPIKO_DISTRIBUTOR_CLIENT_ID=
# SPIKO_DISTRIBUTOR_CLIENT_SECRET=
