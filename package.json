{
  "name": "spiko-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "An Effect-native Model Context Protocol server for Spiko's API.",
  "license": "MIT",
  "bin": {
    "spiko-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "rolldown -c",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.100",
    "effect": "4.0.0-beta.100"
  },
  "devDependencies": {
    "@types/node": "24.10.14",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "rolldown": "1.2.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.15.1"
}
