{
  "name": "spiko-api-toolkit",
  "version": "0.2.0",
  "private": true,
  "description": "Effect-native clients, CLI, and MCP server for Spiko's APIs.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm check:code && pnpm generate:check",
    "check:code": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "changeset": "changeset",
    "changeset-publish": "pnpm build && changeset publish",
    "changeset-version": "changeset version",
    "dev:cli": "pnpm --filter spiko-cli dev",
    "dev:mcp": "pnpm --filter spiko-mcp dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "generate:check": "pnpm generate:clients && git diff --exit-code -- openapi packages/public-api-client/src/generated.ts packages/investor-api-client/src/generated.ts packages/distributor-api-client/src/generated.ts apps/cli/src/generated/operations.ts",
    "generate:clients": "node --experimental-strip-types tools/generate-clients.ts",
    "lint": "oxlint --type-aware --deny-warnings .",
    "postinstall": "effect-tsgo patch --oxlint",
    "specs:update": "node --experimental-strip-types tools/generate-clients.ts --fetch",
    "test": "pnpm --filter './packages/**' -r build && pnpm -r --if-present test",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@effect/openapi-generator": "4.0.0-beta.102",
    "@effect/platform-node": "4.0.0-beta.102",
    "@effect/tsgo": "0.31.0",
    "@types/node": "24.13.3",
    "effect": "4.0.0-beta.102",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "rolldown": "1.2.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
