{
  "name": "@spiko/investor-api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Generated Effect HTTP client for Spiko's Investor API.",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./generated": {
      "types": "./src/generated.ts",
      "default": "./dist/generated.js"
    }
  },
  "scripts": {
    "build": "rolldown -c && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "rolldown": "catalog:",
    "typescript": "catalog:"
  }
}
